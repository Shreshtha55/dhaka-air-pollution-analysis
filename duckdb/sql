5.growth rate of each episode
query = """
WITH threshold AS (
    SELECT
        QUANTILE_CONT(pm2_5, 0.90) AS pm25_limit
    FROM air_quality
    WHERE pm2_5 IS NOT NULL
),

daily AS (
    SELECT
        CAST(date AS DATE) AS date,
        AVG(pm2_5) AS pm2_5,
        AVG(pm10) AS pm10,
        AVG(carbon_monoxide) AS co,
        AVG(nitrogen_dioxide) AS no2,
        AVG(sulphur_dioxide) AS so2,
        AVG(ozone) AS ozone
    FROM air_quality
    GROUP BY CAST(date AS DATE)
),

classified AS (
    SELECT
        d.*,
        CASE
            WHEN d.pm2_5 > t.pm25_limit THEN 1
            ELSE 0
        END AS is_high
    FROM daily d
    CROSS JOIN threshold t
),

with_previous AS (
    SELECT
        *,
        LAG(date) OVER (ORDER BY date) AS previous_date,
        LAG(is_high) OVER (ORDER BY date) AS previous_high
    FROM classified
),

episode_flags AS (
    SELECT
        *,
        CASE
            WHEN is_high = 1 AND (
                previous_high = 0
                OR previous_high IS NULL
                OR date != previous_date + INTERVAL '1 day'
            )
            THEN 1
            ELSE 0
        END AS episode_start
    FROM with_previous
),

numbered AS (
    SELECT
        *,
        SUM(episode_start) OVER (
            ORDER BY date
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS episode_id
    FROM episode_flags
),

episode_days AS (
    SELECT *
    FROM numbered
    WHERE is_high = 1
),

valid_episodes AS (
    SELECT episode_id
    FROM episode_days
    GROUP BY episode_id
    HAVING COUNT(*) >= 3
),

episode_averages AS (
    SELECT
        e.episode_id,
        MIN(e.date) AS start_date,
        MAX(e.date) AS end_date,
        COUNT(*) AS duration_days,
        ROUND(AVG(e.pm2_5), 2) AS avg_pm25,
        ROUND(AVG(e.pm10), 2) AS avg_pm10,
        ROUND(AVG(e.co), 2) AS avg_co,
        ROUND(AVG(e.no2), 2) AS avg_no2,
        ROUND(AVG(e.so2), 2) AS avg_so2,
        ROUND(AVG(e.ozone), 2) AS avg_ozone,

        ROUND(
            (
                ARG_MAX(e.pm2_5, e.date) -
                ARG_MIN(e.pm2_5, e.date)
            ) / NULLIF(ARG_MIN(e.pm2_5, e.date), 0) * 100,
            2
        ) AS pm25_growth_rate

    FROM episode_days e
    JOIN valid_episodes v
        ON e.episode_id = v.episode_id
    GROUP BY e.episode_id
)

SELECT *
FROM episode_averages
ORDER BY duration_days DESC, avg_pm25 DESC;
"""

result = con.execute(query).df()
result

